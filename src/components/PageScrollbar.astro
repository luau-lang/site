<page-scrollbar
    hidden
    role="scrollbar"
    tabindex="0"
    aria-label="Scroll page"
    aria-controls="page-content"
    aria-orientation="vertical"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
>
    <span class="thumb" aria-hidden="true"></span>
</page-scrollbar>

<script src="../lib/page-scrollbar.ts"></script>

<style>
    page-scrollbar {
        position: fixed;
        inset-block: 4px;
        inset-inline-end: 0;
        width: 24px; /* covers the clickable width */
        z-index: calc(var(--sl-z-index-navbar) + 1);
        touch-action: none;
        user-select: none;
    }

    page-scrollbar[hidden] {
        display: none;
    }

    .thumb {
        position: absolute;
        inset-block-start: 0;
        inset-inline-end: 0;
        width: 18px; /* the actual width of the visual dragger */
    }

    .thumb::before {
        content: '';
        position: absolute;
        inset-block: 0;
        inset-inline: 5px;
        border-radius: 999px;
        background-color: var(--sl-color-gray-3);
        opacity: 0.4;
    }

    page-scrollbar:is(:hover, :focus-visible, [data-dragging]) .thumb::before {
        opacity: 0.9;
    }

    page-scrollbar:focus-visible {
        outline: none;
    }

    page-scrollbar:focus-visible .thumb::before {
        outline: 2px solid var(--sl-color-text-accent);
        outline-offset: 1px;
    }

    @media (forced-colors: active) {
        .thumb::before {
            background-color: ButtonText;
            forced-color-adjust: none;
        }
    }

    @media print {
        page-scrollbar {
            display: none;
        }
    }
</style>
